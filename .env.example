# docker compose と API が使う設定。コピーして .env を作る（.env はコミットしない）。

# Postgres のパスワード（本番は強い値に）
POSTGRES_PASSWORD=telemetry_local

# ホスト側の公開ポート
DB_PORT=5433
API_PORT=3001

# API が受け付ける送信元（サイトのオリジン。カンマ区切りで複数可）
# 例（本番）: https://yukikasahara-droid.github.io  や  https://support.orylab.com
ALLOWED_ORIGINS=http://localhost:4322

# API をホストで直接動かす（npm run dev / analyze）ときのDB接続。
# ※ compose の api コンテナは compose 側の DATABASE_URL（db:5432）を使うのでこの値は無視される。
DATABASE_URL=postgres://telemetry:telemetry_local@localhost:5433/telemetry

# 管理ダッシュボード（/admin）の Basic 認証。本番は必ず強い値に。
# 空にすると /admin は無効（503）になる。
ADMIN_USER=admin
ADMIN_PASS=changeme_local
